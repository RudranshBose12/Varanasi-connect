{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "about.varanasiconnect.in"
        }
      ],
      "destination": "https://www.varanasiconnect.in/about",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "events.varanasiconnect.in"
        }
      ],
      "destination": "https://www.varanasiconnect.in/events",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "rules.varanasiconnect.in"
        }
      ],
      "destination": "https://www.varanasiconnect.in/rules",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "reviews.varanasiconnect.in"
        }
      ],
      "destination": "https://www.varanasiconnect.in/reviews",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "varanasiconnect.in"
        }
      ],
      "destination": "https://www.varanasiconnect.in/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/blog-sitemap.xml",
      "destination": "/api/blog-sitemap"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog/:slug"
    }
  ]
}
