{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/about.html",
      "destination": "https://www.varanasiconnect.in/about",
      "permanent": true
    },
    {
      "source": "/events.html",
      "destination": "https://www.varanasiconnect.in/events",
      "permanent": true
    },
    {
      "source": "/rules.html",
      "destination": "https://www.varanasiconnect.in/rules",
      "permanent": true
    },
    {
      "source": "/reviews.html",
      "destination": "https://www.varanasiconnect.in/reviews",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "about.varanasiconnect.in"
        }
      ],
      "destination": "https://www.varanasiconnect.in/about",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "events.varanasiconnect.in"
        }
      ],
      "destination": "https://www.varanasiconnect.in/events",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "rules.varanasiconnect.in"
        }
      ],
      "destination": "https://www.varanasiconnect.in/rules",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "reviews.varanasiconnect.in"
        }
      ],
      "destination": "https://www.varanasiconnect.in/reviews",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "varanasiconnect.in"
        }
      ],
      "destination": "https://www.varanasiconnect.in/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/events",
      "destination": "/events.html"
    },
    {
      "source": "/rules",
      "destination": "/rules.html"
    },
    {
      "source": "/reviews",
      "destination": "/reviews.html"
    }
  ]
}
